# Node 24; never commit .env or put database credentials in VITE_* variables.
API_PORT=3001
HOST=127.0.0.1
# Development uses var/yummyfit.sqlite by default.
# DATABASE_FILE=var/yummyfit.sqlite
# PostgreSQL, required for horizontally scaled deployments:
# DATABASE_URL=postgresql://yummyfit:password@localhost:5432/yummyfit
# PUBLIC frontend values are substituted at build time:
VITE_SITE_BASE=/
# Defaults to <VITE_SITE_BASE>api on the same origin.
# VITE_API_BASE_URL=https://api.your-domain.example/api
# Required for public production startup/build approval checks. Supply your real working address:
# VITE_CONTACT_EMAIL=
# Optional specific HTTPS brand profiles; unset profiles are hidden:
# VITE_INSTAGRAM_URL=
# VITE_LINKEDIN_URL=
# VITE_X_URL=
VITE_GITHUB_URL=https://github.com/wuemilyy-stack/YummyFitWeb
# Exact frontend origins, comma separated, only if API is on another origin:
# CORS_ORIGINS=https://your-domain.example
# Number of trusted reverse-proxy hops; leave zero without a proxy.
TRUST_PROXY_HOPS=0
