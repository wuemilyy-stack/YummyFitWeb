{
  "name": "yummyfit-homepage",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node --env-file-if-exists=.env scripts/dev.mjs",
    "dev:web": "vite",
    "dev:api": "node --env-file-if-exists=.env server/index.mjs",
    "build": "tsc --noEmit && tsc -p tsconfig.node.json --noEmit && vite build",
    "start": "node --env-file-if-exists=.env server/index.mjs",
    "preview": "vite preview",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "check": "npm run build && npm test && npm audit",
    "smoke": "node --env-file-if-exists=.env scripts/smoke.mjs",
    "check:deployment": "node --env-file-if-exists=.env scripts/check-config.mjs"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "framer-motion": "^11.11.0",
    "helmet": "^8.3.0",
    "lucide-react": "^0.453.0",
    "pg": "^8.23.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^6.1.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^8.3.2"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
